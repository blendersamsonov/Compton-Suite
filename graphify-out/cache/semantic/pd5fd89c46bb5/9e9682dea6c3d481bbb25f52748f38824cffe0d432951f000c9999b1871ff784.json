{"nodes": [{"id": "specs_gaussian_paraxial_laser_io", "label": "gaussian_paraxial laser I/O spec (v0.1)", "file_type": "document", "source_file": "docs/io/specs/gaussian_paraxial_laser_io_v0.1.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "concept_rayleigh_range", "label": "Rayleigh range", "file_type": "concept", "source_file": "docs/io/specs/gaussian_paraxial_laser_io_v0.1.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_io_specs_gaussian_paraxial_laser_io_v0_1", "label": "Gaussian Paraxial Laser I/O Spec v0.1", "file_type": "document", "source_file": "docs/io/specs/gaussian_paraxial_laser_io_v0.1.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_io_specs_gaussian_paraxial_laser_io_v0_1_gaussian_paraxial_laser", "label": "GaussianParaxialLaser model (gaussian_paraxial, version 0.1)", "file_type": "concept", "source_file": "docs/io/specs/gaussian_paraxial_laser_io_v0.1.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_io_specs_gaussian_paraxial_laser_io_v0_1_geometric_convention", "label": "Geometric convention: interaction point at origin, electrons +z, laser -z, focus_z_um relative offset", "file_type": "rationale", "source_file": "docs/io/specs/gaussian_paraxial_laser_io_v0.1.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Fixes a right-handed frame with electrons along +z and laser along -z so every consuming model shares one unambiguous convention for where the interaction point and focus offset sit, independent of each model's own internal unit system."}, {"id": "docs_io_specs_gaussian_paraxial_laser_io_v0_1_input_parameters", "label": "Minimal v0.1 input parameters (pulse_energy_J, wavelength_um, waist_rms_x_um, waist_rms_y_um, duration_rms_fs, focus_z_um, propagation_direction)", "file_type": "rationale", "source_file": "docs/io/specs/gaussian_paraxial_laser_io_v0.1.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "v0.1 is deliberately minimal: only the parameters needed to unambiguously fix energy, focus position, transverse size, duration and wavelength of a single Gaussian pulse are included; everything else is deferred to a later spec version."}, {"id": "docs_io_specs_gaussian_paraxial_laser_io_v0_1_transverse_size_definition", "label": "Transverse intensity size definition (sigma_x0, sigma_y0; FWHM and 1/e^2 waist w0 relations)", "file_type": "concept", "source_file": "docs/io/specs/gaussian_paraxial_laser_io_v0.1.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "waist_rms_x_um/waist_rms_y_um are explicitly rms sizes of the intensity profile (not the field), so downstream FWHM and 1/e^2 radius conversions must use the intensity-profile Gaussian, avoiding a field-vs-intensity convention mismatch."}, {"id": "docs_io_specs_gaussian_paraxial_laser_io_v0_1_duration_definition", "label": "Temporal intensity duration definition (sigma_t; FWHM relation)", "file_type": "concept", "source_file": "docs/io/specs/gaussian_paraxial_laser_io_v0.1.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "duration_rms_fs is the rms duration of the intensity envelope, not the field envelope, matching the same intensity-vs-field convention used for transverse size."}, {"id": "docs_io_specs_gaussian_paraxial_laser_io_v0_1_energy_power_intensity", "label": "Pulse energy, peak power and peak intensity (E_L, P_peak, I0_focus, I0_interaction)", "file_type": "concept", "source_file": "docs/io/specs/gaussian_paraxial_laser_io_v0.1.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Peak intensity is defined by convention in W/cm^2 (not SI W/m^2) so implementers must explicitly convert sigma_x0/sigma_y0 to cm and sigma_t to s at this boundary before computing I0_focus."}, {"id": "docs_io_specs_gaussian_paraxial_laser_io_v0_1_rayleigh_length", "label": "Rayleigh length z_Rx, z_Ry (per-axis, from 1/e^2 waist and wavelength)", "file_type": "concept", "source_file": "docs/io/specs/gaussian_paraxial_laser_io_v0.1.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_io_specs_gaussian_paraxial_laser_io_v0_1_beam_size_at_interaction", "label": "Beam size and intensity at the interaction point (paraxial defocus formula, sigma_x(z=0), sigma_y(z=0))", "file_type": "concept", "source_file": "docs/io/specs/gaussian_paraxial_laser_io_v0.1.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "When the focus is offset from the interaction point (focus_z_um != 0), the standard paraxial expansion formula is used so peak intensity at the interaction point can differ from the focal peak intensity."}, {"id": "docs_io_specs_gaussian_paraxial_laser_io_v0_1_a0_amplitude", "label": "Normalized amplitude a0 (a0_focus, a0_interaction), derived not input", "file_type": "rationale", "source_file": "docs/io/specs/gaussian_paraxial_laser_io_v0.1.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "a0 is explicitly not an input parameter in v0.1; it is always derived from peak intensity and wavelength via the plane-wave definition a0 = eE0/(m_e c omega0), so every consumer computes it the same way instead of accepting it as a free input."}, {"id": "docs_io_specs_gaussian_paraxial_laser_io_v0_1_derived_output_parameters", "label": "Recommended derived output parameters (waist radii, FWHM, Rayleigh lengths, peak power/intensity, a0)", "file_type": "concept", "source_file": "docs/io/specs/gaussian_paraxial_laser_io_v0.1.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_io_specs_gaussian_paraxial_laser_io_v0_1_validity_checks", "label": "Input validity checks and warnings (positivity, propagation_direction, focus-vs-Rayleigh-length, ellipticity)", "file_type": "concept", "source_file": "docs/io/specs/gaussian_paraxial_laser_io_v0.1.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_io_specs_gaussian_paraxial_laser_io_v0_1_out_of_scope_v0_1", "label": "Explicitly out of scope for v0.1 (f_rep, P_avg, astigmatism, polarization, CEP, chirp, multi-pulse, non-Gaussian modes)", "file_type": "rationale", "source_file": "docs/io/specs/gaussian_paraxial_laser_io_v0.1.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Deliberately excludes repetition-rate/average-power bookkeeping, astigmatism as independent x/y focus positions, complex q-parameters, M^2 beam quality, polarization, CEP, chirp, spatio-temporal couplings, off-axis offsets, incidence angle, non-Gaussian/super-Gaussian/Laguerre-/Hermite-Gaussian modes, and multi-pulse support, to keep v0.1 a minimal working contract."}, {"id": "docs_io_specs_gaussian_paraxial_laser_io_v0_1_example_input_yaml", "label": "Minimal example input YAML (laser: model gaussian_paraxial, version 0.1)", "file_type": "document", "source_file": "docs/io/specs/gaussian_paraxial_laser_io_v0.1.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_io_specs_gaussian_paraxial_laser_io_v0_1_mermaid_diagram", "label": "Mermaid schema summarizing v0.1 spec (input/convention/derived flowchart)", "file_type": "document", "source_file": "docs/io/specs/gaussian_paraxial_laser_io_v