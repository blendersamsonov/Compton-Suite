*.pyc
*.egg-info/
.venv/
build/
dist/
.pytest_cache/
.DS_Store

# Claude Code session/tool state (settings, worktree admin, knowledge-graph
# cache) -- not source, regenerate/reconfigure locally as needed.
.claude/

